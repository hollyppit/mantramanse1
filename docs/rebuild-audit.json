 ],
 "dups": [
  {
   "s": "위 그래프에서 표시된 \"나를 채워 주는 기운\"이 이 오행이고, 이미 넘치는 기운을 더 키우는 사람과는 부딪히기 쉬워요.",
   "n": 15
  },
  {
   "s": "서로 다른 방향으로 끄는 두 힘이 함께 커서 생기는 내적 모순이고, 성격의 결함이 아니라 선택을 어렵게 하는 구조를 설명하는 해석이에요.",
   "n": 14
  },
  {
   "s": "신강(나를 돕는 힘이 큰 편)은 일간을 돕는 비겁(나와 같은 기운, 동료·경쟁)·인성(배움·도움의 기운)이 상대적으로 많다는 분류예요.",
   "n": 10
  },
  {
   "s": "내 기준과 추진력이 바깥 요구보다 앞서기 쉬운 쪽이에요.",
   "n": 10
  },
  {
   "s": "중화(힘이 고른 편)는 일간을 돕는 힘과 덜어내는 힘이 크게 기울지 않았다는 분류예요.",
   "n": 10
  },
  {
   "s": "상황에 따라 앞에 서기도 하고 물러서기도 하는 쪽이에요.",
   "n": 10
  },
  {
   "s": "신약(나를 돕는 힘이 약한 편)은 일간을 덜어내는 식상(표현·재주의 기운)·재성(돈·재물의 기운)·관성(직장·책임의 기운)이 상대적으로 많다는 분류예요.",
   "n": 10
  },
  {
   "s": "바깥 요구와 일의 양이 내 힘을 앞지르기 쉬운 쪽이에요.",
   "n": 10
  },
  {
   "s": "이 기질이 막히거나 과해질 때 스트레스로 나타나는 경향을 읽는 해석이고, 건강 상태나 질병을 진단하지는 않아요.",
   "n": 10
  },
  {
   "s": "다만 압박이나 경쟁이 성장을 보장하는 것은 아니에요.",
   "n": 10
